# ---------------------------------------------------------------------------
# Minecraft server - environment variables
# Copy this file to .env and fill in your actual values before running:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Shared with core stack - should match your main .env
APPDATA=/srv/appdata
TZ=Indian/Maldives 

# Minecraft-specific
# ---------------------------------------------------------------------------

# MC_MEMORY - JVM heap size. Format: number + G or M (e.g. 2G, 4G, 6144M)
# Rule of thumb: 2G minimum for vanilla/small survival, 4G+ once you add
# plugins/mods or more than a couple players. Leave ~1-2GB headroom on the
# host for the OS and your other containers.
MC_MEMORY=4G

# MC_VERSION - Minecraft version to run.
#   LATEST    - always pulls the newest stable release (auto-updates on restart)
#   SNAPSHOT  - latest snapshot/pre-release build
#   1.20.4    - or any specific version number, e.g. 1.20.1, 1.19.4, 1.16.5
# Pin to a specific version if you're using plugins/mods that haven't
# updated for the newest release yet - LATEST can break compatibility.
MC_VERSION=LATEST

# MC_TYPE - server software / mod loader. Main supported values:
#   VANILLA   - official Mojang server, no plugins or mods
#   PAPER     - Spigot-based, plugin support, best performance (needed for Geyser/Floodgate)
#   SPIGOT    - plugin support, predecessor to Paper, slower/less optimized
#   FABRIC    - lightweight mod loader (Fabric mods only, not Forge)
#   FORGE     - most widely-used mod loader (Forge mods only, not Fabric)
#   NEOFORGE  - actively-maintained Forge fork, used by many newer modpacks
#   QUILT     - Fabric-compatible fork with extra modding features
#   PURPUR    - Paper fork with extra config options/features, still plugin-compatible
# Note: plugins (Paper/Spigot/Purpur) and mods (Forge/Fabric/NeoForge/Quilt)
# are NOT interchangeable - pick one ecosystem. Geyser/Floodgate (Bedrock
# cross-play) requires PAPER, SPIGOT, or PURPUR.
MC_TYPE=PAPER