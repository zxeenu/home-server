# Copy this file to ".env" (same folder as docker-compose.yml) and fill in real values.

# --- General ---
TZ=Indian/Maldives           # your timezone, e.g. Europe/London
PUID=1000                    # run `id -u` on your Linux host to get this
PGID=1000                    # run `id -g` on your Linux host to get this
DOMAIN_NAME=                 # the domain local services run on
IP_ADDRESS=                  # this boxes ip address

# --- Paths on the HOST machine ---
APPDATA=/srv/appdata         # where container configs/databases live
                              # (needs subfolders: npm, portainer, pihole, plex, qbittorrent,
                              #  stirlingpdf, calibreweb, ntfy, sonarr, radarr, prowlarr)
MEDIA=/srv/media             # where movies/tv/downloads/books live (needs your storage mounted here)

# --- Pi-hole ---
PIHOLE_PASSWORD=changeme
SERVER_IP=192.168.100.64

# --- Samba network share ---
SMB_PASSWORD=changeme

# --- Tailscale ---
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
LAN_SUBNET=192.168.1.0/24

# --- Homepage --- Put your default logins here if needed

NOTE_PLEX="Direct play preferred"
NOTE_QBITTORRENT="Default admin/admin"
NOTE_PIHOLE=""
NOTE_PORTAINER=""
NOTE_TRAEFIK="Dashboard at /dashboard"
NOTE_STIRLINGPDF=""
NOTE_NTFY=""
NOTE_CALIBREWEB=""

NTFY_TOPIC=home-alerts
HOMEPAGE_PORT=8888

# --- Traefik  --- Optional dashboard auth (if you uncomment the basicauth lines)
TRAEFIK_USER=admin
TRAEFIK_PASSWORD_HASH= # generate via openssl passwd -apr1 yourpassword

# --- Cloudflare ---
ACME_EMAIL=your-email@example.com
CF_DNS_API_TOKEN=your-cloudflare-api-token

# --- Uptime Kuma ---
KUMA_USERNAME=admin
KUMA_PASSWORD=your-strong-password
NTFY_UPTIME_KUMA_TOPIC=your-long-unguessable-topic-name